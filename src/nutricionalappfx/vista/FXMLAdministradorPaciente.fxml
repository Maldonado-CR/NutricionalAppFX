<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="550.0" minWidth="850.0" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nutricionalappfx.controlador.FXMLAdministradorPacienteController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f4f6f8; -fx-border-color: #dcdcdc; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#handleBotonRegresar" text="← Regresar" />
            <Label fx:id="lbTitulo" text="Administrador Pacientes">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCerrarSesion" mnemonicParsing="false" text="Cerrar Sesión" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <TextField fx:id="tfBuscar" prefHeight="30.0" prefWidth="280.0" promptText="Buscar paciente por código o nombre..." />
                  <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#handleBotonBuscar" prefHeight="30.0" text="Buscar" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#handleBotonAlta" prefHeight="30.0" prefWidth="85.0" style="-fx-background-color: #5cb85c; -fx-text-fill: white;" text="Registrar" />
                  <Button mnemonicParsing="false" onAction="#handleBotonEditar" prefHeight="30.0" prefWidth="85.0" style="-fx-background-color: #4389F1; -fx-text-fill: white;" text="Edición" />
                  <Button fx:id="btnBaja" mnemonicParsing="false" onAction="#handleBotonBaja" prefHeight="30.0" prefWidth="85.0" style="-fx-background-color: #d9534f; -fx-text-fill: white;" text="Eliminar" />
               </children>
            </HBox>
            <TableView fx:id="tvPacientes" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colCodigo" prefWidth="110.0" text="Código" />
                  <TableColumn fx:id="colNombreCompleto" prefWidth="230.0" text="Nombre completo" />
                  <TableColumn fx:id="colTelefono" prefWidth="120.0" text="Teléfono" />
                  <TableColumn fx:id="colCorreo" prefWidth="190.0" text="Correo" />
                  <TableColumn fx:id="colFechaNacimiento" prefWidth="115.0" text="Fecha nac." />
                  <TableColumn fx:id="colSexo" prefWidth="90.0" text="Sexo" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
